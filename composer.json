{
    "name": "tollwerk/tw-icons",
    "type": "typo3-cms-extension",
    "description": "Provide Icon-ViewHelper for including SVG icons in Fluid Templates",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "TYPO3",
        "extension",
        "article",
        "news"
    ],
    "authors": [
        {
            "name": "Klaus Fiedler",
            "role": "Developer",
            "email": "klaus@tollwerk.de",
            "homepage": "https://tollwerk.de"
        }
    ],
    "homepage": "https://tollwerk.de",
    "support": {
        "issues": "https://github.com/tollwerk/TYPO3-ext-tw_icons/issues",
        "source": "https://github.com/tollwerk/TYPO3-ext-tw_icons",
        "docs": "https://github.com/tollwerk/TYPO3-ext-tw_icons"
    },
    "require": {
        "php": ">= 7.4 < 8.5",
        "typo3/cms-core": "^13",
        "typo3/cms-fluid-styled-content": "^13"
    },
    "autoload": {
        "psr-4": {
            "Tollwerk\\TwIcons\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "tw_icons"
        },
        "branch-alias": {
            "dev-master": "13.0.x-dev"
        }
    }
}
